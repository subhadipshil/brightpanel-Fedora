# Auto detect text files and perform LF normalization
* text=auto

# Linux scripts and system configs MUST always use LF (Unix line endings)
# Prevents '/bin/bash^M: bad interpreter' error when cloned on Linux from Windows
*.sh text eol=lf
*.service text eol=lf
*.rules text eol=lf
*.spec text eol=lf
*.desktop text eol=lf
*.conf text eol=lf

# Source code & configs
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.toml text eol=lf

# Binary media and package files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.tar.gz binary
*.rpm binary
